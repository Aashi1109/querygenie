{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "sourceMap": true,
    "outDir": "dist",
    "sourceRoot": ".",
    "baseUrl": "./",
    "skipLibCheck": true,
    "paths": {
      "*": ["node_modules/*"],
      "@*": ["./*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "misc"]
}
